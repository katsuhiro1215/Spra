import React, { useState } from "react";
import { Head, router } from "@inertiajs/react";
import AdminAuthenticatedLayout from "@/Layouts/AdminAuthenticatedLayout";
import PageHeader from "@/Components/Layout/PageHeader";
import { FlashMessage } from "@/Components/Notifications";
import { PrimaryButton, SecondaryButton, DangerButton } from "@/Components/Buttons";
import { Card } from "@/Components/Card";
import {
    ArrowLeftIcon,
    PencilIcon,
    DocumentTextIcon,
    XCircleIcon,
    TrashIcon,
    PaperAirplaneIcon,
    PlusIcon,
} from "@heroicons/react/24/outline";

// Custom Components
import ContractBasicInfo from "./_components/ContractBasicInfo";
import ContractItems from "./_components/ContractItems";
import ContractAmount from "./_components/ContractAmount";
import ContractVersionHistory from "./_components/ContractVersionHistory";
import ContractClientInfo from "./_components/ContractClientInfo";

export default function Show({ contract }) {
    const [activeTab, setActiveTab] = useState("basic");

    const tabs = [
        { id: "basic", label: "基本情報", icon: "📋" },
        { id: "items", label: "契約明細", icon: "📝" },
        { id: "amount", label: "金額情報", icon: "💰" },
        { id: "terms", label: "契約条項", icon: "📄" },
        { id: "versions", label: "バージョン履歴", icon: "📜" },
        { id: "client", label: "クライアント情報", icon: "👤" },
    ];

    const STATUSES = {
        draft: "下書き",
        pending_review: "レビュー待ち",
        approved: "承認済み",
        sent: "送信済み",
        pending_signature: "署名待ち",
        signed: "署名済み",
        active: "有効",
        suspended: "一時停止",
        completed: "完了",
        cancelled: "キャンセル",
    };

    const handleEdit = () => {
        router.get(route("admin.contract.edit", contract.id));
    };

    const handleCancel = () => {
        const reason = prompt("キャンセル理由を入力してください（任意）:");
        if (reason !== null) {
            router.patch(route("admin.contract.cancel", contract.id), {
                cancellation_reason: reason,
            });
        }
    };

    const handleDelete = () => {
        if (confirm(`契約「${contract.title}」を削除してもよろしいですか？`)) {
            router.delete(route("admin.contract.destroy", contract.id));
        }
    };

    const headerActions = [
        {
            label: "戻る",
            icon: ArrowLeftIcon,
            variant: "ghost",
            route: route("admin.contract.index"),
        },
    ];

    if (contract.status === "draft") {
        headerActions.push({
            label: "編集",
            icon: PencilIcon,
            variant: "secondary",
            onClick: handleEdit,
        });
    }

    const breadcrumbs = [
        { label: "ダッシュボード", href: "/admin/dashboard" },
        { label: "契約一覧", href: route("admin.contract.index") },
        { label: contract.contract_number || contract.title, href: null },
    ];

    return (
        <AdminAuthenticatedLayout
            header={
                <PageHeader
                    title={contract.title}
                    description={`${STATUSES[contract.status] || contract.status} • ${contract.contract_number}`}
                    actions={headerActions}
                    breadcrumbs={breadcrumbs}
                />
            }
        >
            <Head title={`契約詳細 - ${contract.title}`} />
            <FlashMessage />

            {/* アクションボタン */}
            <div className="mb-6 flex justify-end gap-3">
                {contract.status === "active" && (
                    <>
                        <PrimaryButton
                            onClick={() => {
                                router.get(
                                    route("admin.projects.create", {
                                        contract_id: contract.id,
                                    }),
                                );
                            }}
                        >
                            <DocumentTextIcon className="h-4 w-4 mr-2" />
                            プロジェクト作成
                        </PrimaryButton>
                        <PrimaryButton
                            onClick={() => {
                                router.post(
                                    route(
                                        "admin.invoice.create-from-contract",
                                        contract.id,
                                    ),
                                );
                            }}
                        >
                            <DocumentTextIcon className="h-4 w-4 mr-2" />
                            請求書作成
                        </PrimaryButton>
                        <SecondaryButton onClick={handleCancel}>
                            <XCircleIcon className="h-4 w-4 mr-2" />
                            契約をキャンセル
                        </SecondaryButton>
                    </>
                )}
                {contract.status === "draft" && (
                    <SecondaryButton
                        onClick={handleDelete}
                        className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                    >
                        <TrashIcon className="h-4 w-4 mr-2" />
                        削除
                    </SecondaryButton>
                )}
            </div>

            {/* タブ */}
            <div className="mb-6 border-b border-gray-200 dark:border-gray-700 overflow-x-auto">
                <div className="flex space-x-8 min-w-max">
                    {tabs.map((tab) => (
                        <button
                            key={tab.id}
                            onClick={() => setActiveTab(tab.id)}
                            className={`px-1 py-4 text-sm font-medium border-b-2 transition-colors whitespace-nowrap ${
                                activeTab === tab.id
                                    ? "border-blue-500 text-blue-600 dark:text-blue-400"
                                    : "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600"
                            }`}
                        >
                            {tab.label}
                        </button>
                    ))}
                </div>
            </div>

            {/* タブコンテンツ */}
            <div className="space-y-6">
                {activeTab === "basic" && (
                    <ContractBasicInfo
                        contract={contract}
                        statuses={STATUSES}
                    />
                )}
                {activeTab === "items" && <ContractItems contract={contract} />}
                {activeTab === "amount" && (
                    <ContractAmount contract={contract} />
                )}
                {activeTab === "versions" && (
                    <ContractVersionHistory contract={contract} />
                )}
                {activeTab === "client" && (
                    <ContractClientInfo contract={contract} />
                )}
            </div>
        </AdminAuthenticatedLayout>
    );
}

    const tabs = [
        { id: "basic", label: "基本情報" },
        { id: "client", label: "クライアント" },
        { id: "service", label: "サービス" },
        { id: "billing", label: "請求設定" },
        { id: "signature", label: "署名状況" },
        { id: "mail", label: "メール履歴" },
    ];

    const getStatusLabel = (status) => {
        const labels = {
            draft: "下書き",
            pending_signature: "署名待ち",
            active: "契約中",
            cancelled: "キャンセル",
        };
        return labels[status] || status;
    };

    const handleActivate = () => {
        if (
            confirm(`契約「${contract.title}」を有効化してもよろしいですか？`)
        ) {
            router.patch(route("admin.contract.activate", contract.id));
        }
    };

    const handleCancel = () => {
        const reason = prompt("キャンセル理由を入力してください（任意）:");
        if (reason !== null) {
            router.patch(route("admin.contract.cancel", contract.id), {
                cancellation_reason: reason,
            });
        }
    };

    const handleDelete = () => {
        if (confirm(`契約「${contract.title}」を削除してもよろしいですか？`)) {
            router.delete(route("admin.contract.destroy", contract.id));
        }
    };

    const handleSend = () => {
        if (confirm(`契約書をメール送信してもよろしいですか？`)) {
            router.post(route("admin.contract.send", contract.id));
        }
    };

    const headerActions = [
        {
            label: "戻る",
            icon: ArrowLeftIcon,
            variant: "ghost",
            route: route("admin.contract.index"),
        },
    ];

    if (
        contract.status === "draft" ||
        contract.status === "pending_signature"
    ) {
        headerActions.push({
            label: "編集",
            icon: PencilIcon,
            variant: "secondary",
            route: route("admin.contract.edit", contract.id),
        });
    }

    const breadcrumbs = [
        { label: "ダッシュボード", href: "/admin/dashboard" },
        { label: "契約一覧", href: route("admin.contract.index") },
        { label: contract.contract_number || contract.title, href: null },
    ];

    return (
        <AdminAuthenticatedLayout
            header={
                <PageHeader
                    title={contract.title}
                    description={`${getStatusLabel(contract.status)} • ${contract.contract_number}`}
                    actions={headerActions}
                    breadcrumbs={breadcrumbs}
                />
            }
        >
            <Head title={`契約詳細 - ${contract.title}`} />
            <FlashMessage />

            {/* アクションボタン - 右上 */}
            <div className="mb-6 flex justify-end gap-3">
                {(contract.status === "draft" ||
                    contract.status === "pending_signature") && (
                    <>
                        <SecondaryButton onClick={handleSend}>
                            <DocumentArrowUpIcon className="h-4 w-4 mr-2" />
                            メール送信
                        </SecondaryButton>
                        <PrimaryButton onClick={handleActivate}>
                            <DocumentTextIcon className="h-4 w-4 mr-2" />
                            契約を有効化
                        </PrimaryButton>
                    </>
                )}
                {contract.status === "active" && (
                    <div className="flex gap-3">
                        <PrimaryButton
                            onClick={() => {
                                router.get(
                                    route("admin.projects.create", {
                                        contract_id: contract.id,
                                    }),
                                );
                            }}
                        >
                            <DocumentTextIcon className="h-4 w-4 mr-2" />
                            プロジェクト作成
                        </PrimaryButton>
                        <PrimaryButton
                            onClick={() => {
                                router.post(
                                    route(
                                        "admin.invoice.create-from-contract",
                                        contract.id,
                                    ),
                                );
                            }}
                        >
                            <DocumentTextIcon className="h-4 w-4 mr-2" />
                            請求書作成
                        </PrimaryButton>
                        <SecondaryButton onClick={handleCancel}>
                            <XCircleIcon className="h-4 w-4 mr-2" />
                            契約をキャンセル
                        </SecondaryButton>
                    </div>
                )}
                {contract.status === "draft" && (
                    <SecondaryButton
                        onClick={handleDelete}
                        className="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                    >
                        <TrashIcon className="h-4 w-4 mr-2" />
                        削除
                    </SecondaryButton>
                )}
            </div>

            {/* 契約者・会社情報（タブ上部） */}
            <div className="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                {contract.user && (
                    <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4">
                        <p className="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">
                            契約者
                        </p>
                        <p className="text-lg font-bold text-gray-900 dark:text-white">
                            {contract.user.profile?.name || contract.user.email}
                        </p>
                        <p className="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            {contract.user.email}
                        </p>
                    </div>
                )}
                {contract.company && (
                    <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4">
                        <p className="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">
                            会社名
                        </p>
                        <p className="text-lg font-bold text-gray-900 dark:text-white">
                            {contract.company.name}
                        </p>
                        {contract.company.addresses &&
                            contract.company.addresses.length > 0 && (
                                <p className="text-sm text-gray-600 dark:text-gray-400 mt-1 line-clamp-1">
                                    {contract.company.addresses[0].prefecture}
                                    {contract.company.addresses[0].city}
                                </p>
                            )}
                    </div>
                )}
            </div>

            {/* メインレイアウト - 2カラム */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {/* 左側パネル - タブ + 情報 */}
                <div className="lg:col-span-2">
                    {/* タブ */}
                    <div className="mb-6 border-b border-gray-200 dark:border-gray-700 overflow-x-auto">
                        <div className="flex space-x-8 min-w-max">
                            {tabs.map((tab) => (
                                <button
                                    key={tab.id}
                                    onClick={() => setActiveTab(tab.id)}
                                    className={`px-1 py-4 text-sm font-medium border-b-2 transition-colors whitespace-nowrap ${
                                        activeTab === tab.id
                                            ? "border-blue-500 text-blue-600 dark:text-blue-400"
                                            : "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600"
                                    }`}
                                >
                                    {tab.label}
                                </button>
                            ))}
                        </div>
                    </div>

                    {/* タブコンテンツ */}
                    <div>
                        {activeTab === "basic" && (
                            <BasicInfo contract={contract} />
                        )}
                        {activeTab === "client" && (
                            <ClientInfo contract={contract} />
                        )}
                        {activeTab === "service" && (
                            <ServiceInfo contract={contract} />
                        )}
                        {activeTab === "billing" && (
                            <BillingInfo contract={contract} />
                        )}
                        {activeTab === "signature" && (
                            <SignatureStatus contract={contract} />
                        )}
                        {activeTab === "mail" && (
                            <MailHistory contract={contract} />
                        )}
                    </div>
                </div>

                {/* 右側パネル - PDF プレビュー */}
                <div className="lg:col-span-1">
                    <div className="sticky top-24 rounded-lg shadow-sm overflow-hidden">
                        {/* 契約書PDF表示 */}
                        <div
                            style={{
                                height: "600px",
                                overflow: "auto",
                                backgroundColor: "#f5f5f5",
                                borderRadius: "8px",
                                border: "1px solid #e5e7eb",
                            }}
                            className="dark:border-gray-700 dark:bg-gray-900"
                        >
                            <iframe
                                src={route(
                                    "admin.contract.pdf.preview",
                                    contract.id,
                                )}
                                style={{
                                    width: "100%",
                                    height: "100%",
                                    border: "none",
                                }}
                                title="契約書PDF"
                            />
                        </div>

                        {/* ダウンロード・情報セクション */}
                        <div className="mt-4 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 space-y-4">
                            {/* ステータス */}
                            <div>
                                <p className="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                                    ステータス
                                </p>
                                <div className="mt-2 inline-block px-3 py-1 rounded-full text-sm font-medium bg-blue-50 dark:bg-blue-900 text-blue-700 dark:text-blue-300">
                                    {getStatusLabel(contract.status)}
                                </div>
                            </div>

                            {/* 契約番号 */}
                            <div className="border-t border-gray-200 dark:border-gray-700 pt-4">
                                <p className="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                                    契約番号
                                </p>
                                <p className="mt-2 text-lg font-mono font-bold text-gray-900 dark:text-white">
                                    {contract.contract_number}
                                </p>
                            </div>

                            {/* PDF ダウンロード */}
                            <div className="border-t border-gray-200 dark:border-gray-700 pt-4">
                                <a
                                    href={route(
                                        "admin.contract.pdf",
                                        contract.id,
                                    )}
                                    download
                                    className="w-full inline-block text-center px-4 py-2 bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600 text-white rounded-lg transition-colors text-sm font-medium"
                                >
                                    PDF をダウンロード
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </AdminAuthenticatedLayout>
    );
}
