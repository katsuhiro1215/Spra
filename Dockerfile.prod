# syntax=docker/dockerfile:1
#
# 本番用マルチステージビルド（T15/T16）。
# 開発環境（compose.yaml / vendor/laravel/sail/runtimes/8.4）はソースをバインドマウントする方式だが、
# 本番ではイメージにコードを焼き込む。appステージ（php-fpm）が9000番で待ち受け、
# caddyステージ（リバースプロキシ + 自動HTTPS）から接続する構成（compose.prod.yaml参照）。

########################################
# Stage 1: PHP依存関係のインストール
########################################
FROM composer:2.7 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
# composer:2.7イメージにはgd/bcmath/pcntl等の実行時拡張が入っていないため、
# 依存解決のみを行うこの段階では --ignore-platform-reqs で拡張チェックを無視する。
# 実際の拡張は最終イメージ（appステージ）でインストールする。
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction \
    --ignore-platform-reqs

COPY . .

RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

########################################
# Stage 2: フロントエンドビルド（Vite）
########################################
FROM node:22-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

########################################
# Stage 3: 実行用イメージ
########################################
FROM php:8.4-fpm-alpine AS app

RUN apk add --no-cache \
        icu-libs \
        libzip \
        libpng \
        libjpeg-turbo \
        libwebp \
        freetype \
        oniguruma \
        libxml2 \
    && apk add --no-cache --virtual .build-deps \
        icu-dev \
        libzip-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        libwebp-dev \
        freetype-dev \
        oniguruma-dev \
        libxml2-dev \
        $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql \
        mbstring \
        bcmath \
        exif \
        gd \
        intl \
        zip \
        opcache \
        pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/*

WORKDIR /var/www/html

# アプリケーションソース（.dockerignoreでvendor/node_modules/public/build等は除外済み）
COPY . .

# ビルド済み成果物を上書きコピー（COPY . . より後に配置し、確実に反映させる）
COPY --from=vendor /app/vendor ./vendor
COPY --from=frontend /app/public/build ./public/build

RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

USER www-data

EXPOSE 9000

CMD ["php-fpm"]

########################################
# Stage 4: Caddy（リバースプロキシ + 静的ファイル配信、T16）
########################################
# php-fpm（appステージ）へfastcgiで接続するには、Caddy側のrootパスとphp-fpm側の実ファイルパスが
# 一致している必要がある（SCRIPT_FILENAMEの解決に使われるため）。そのため、appステージと同じ
# /var/www/html/public にpublicディレクトリ（ソース資材＋Viteビルド成果物）を配置する。
FROM caddy:2-alpine AS caddy

WORKDIR /var/www/html

COPY --from=vendor /app/public ./public
COPY --from=frontend /app/public/build ./public/build

# アップロードされたメディア（storage/app/public、compose.prod.yamlのapp-storageボリューム経由で
# appコンテナと共有）をCaddyのfile_serverが配信できるよう、public/storageシンボリックリンクを
# 作成する（php artisan storage:linkと同じ相対パス）。ビルド時点ではリンク先は存在しないが、
# 実行時にapp-storageボリュームがマウントされることで解決される。
RUN ln -sfn ../storage/app/public public/storage

COPY Caddyfile /etc/caddy/Caddyfile

