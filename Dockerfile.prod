# syntax=docker/dockerfile:1
#
# 本番用マルチステージビルド（T15）。
# 開発環境（compose.yaml / vendor/laravel/sail/runtimes/8.4）はソースをバインドマウントする方式だが、
# 本番ではイメージにコードを焼き込む。php-fpmで待ち受け、リバースプロキシ（nginx等、T16のcompose.prod.yamlで追加）
# から9000番ポートへ接続する構成を想定している。

########################################
# Stage 1: PHP依存関係のインストール
########################################
FROM composer:2.7 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
# composer:2.7イメージにはgd/bcmath/pcntl等の実行時拡張が入っていないため、
# 依存解決のみを行うこの段階では --ignore-platform-reqs で拡張チェックを無視する。
# 実際の拡張は最終イメージ（appステージ）でインストールする。
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction \
    --ignore-platform-reqs

COPY . .

RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

########################################
# Stage 2: フロントエンドビルド（Vite）
########################################
FROM node:22-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

########################################
# Stage 3: 実行用イメージ
########################################
FROM php:8.4-fpm-alpine AS app

RUN apk add --no-cache \
        icu-libs \
        libzip \
        libpng \
        libjpeg-turbo \
        freetype \
        oniguruma \
        libxml2 \
    && apk add --no-cache --virtual .build-deps \
        icu-dev \
        libzip-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        oniguruma-dev \
        libxml2-dev \
        $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql \
        mbstring \
        bcmath \
        exif \
        gd \
        intl \
        zip \
        opcache \
        pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/*

WORKDIR /var/www/html

# アプリケーションソース（.dockerignoreでvendor/node_modules/public/build等は除外済み）
COPY . .

# ビルド済み成果物を上書きコピー（COPY . . より後に配置し、確実に反映させる）
COPY --from=vendor /app/vendor ./vendor
COPY --from=frontend /app/public/build ./public/build

RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

USER www-data

EXPOSE 9000

CMD ["php-fpm"]
